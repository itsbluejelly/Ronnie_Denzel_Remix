{
  "name": "remixjs-tutorial",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "prisma generate --schema=./prisma/schema.prod.prisma && remix vite:build",
    "dev": "remix vite:dev",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "prisma:migrate:prod": "bunx prisma db push --schema=./prisma/schema.prod.prisma",
    "prisma:migrate:dev": "bunx prisma migrate dev --create-only --schema=./prisma/schema.dev.prisma",
    "prisma:studio:prod": "bunx prisma studio --schema=./prisma/schema.prod.prisma",
    "prisma:studio:dev": "bunx prisma studio  --schema=./prisma/schema.dev.prisma",
    "prisma:seed": "tsx ./prisma/seed/seed.ts",
    "prisma:unseed": "tsx ./prisma/seed/unseed.ts",
    "test": "bunx prisma migrate deploy --schema=./prisma/schema.dev.prisma && vitest",
    "test:unit": "vitest --ui"
  },
  "dependencies": {
    "@conform-to/react": "^1.1.5",
    "@conform-to/zod": "^1.1.5",
    "@prisma/client": "^5.17.0",
    "@remix-run/node": "^2.9.2",
    "@remix-run/react": "^2.9.2",
    "@remix-run/serve": "^2.9.2",
    "@types/validator": "^13.12.0",
    "isbot": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "validator": "^13.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@remix-run/dev": "^2.9.2",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint": "^8.38.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prisma": "^5.17.0",
    "typescript": "^5.1.6",
    "vite": "^5.1.0",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^2.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}